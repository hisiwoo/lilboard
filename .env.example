# Local sqlite (libsql). Use libsql://...turso.io + TURSO_AUTH_TOKEN in prod.
DATABASE_URL="file:./dev.db"

# Solana
# Server-side RPC (Helius/QuickNode key goes here; never exposed to the browser — the client uses /api/rpc)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
# Pump.fun token CA that pays for pixels. While empty the game is LOCKED ("launching soon", all writes 503).
# Set it (or run `npm run launch -- <CA>`) and the game goes live.
NEXT_PUBLIC_PIXEL_MINT=""
NEXT_PUBLIC_PIXEL_SYMBOL="LILBOARD"
# Dev only: NEXT_PUBLIC_FREE_MODE=1 unlocks the game with no payments (never set this in production)
NEXT_PUBLIC_FREE_MODE=""
NEXT_PUBLIC_PIXEL_DECIMALS="6"
# Wallet that receives pixel fees
NEXT_PUBLIC_TREASURY_WALLET=""

# Base price per pixel in whole tokens (overwrite doubles it, up to x16)
NEXT_PUBLIC_BASE_PIXEL_PRICE="100"
# Treasury hot-wallet secret (base64 or JSON array) — needed for claims (payback/jackpot) and `npm run burn`
TREASURY_SECRET_KEY=""
# Jackpot round length in hours
ROUND_HOURS="24"
# Free pixel cooldown (seconds)
FREE_PIXEL_COOLDOWN="30"
# Comma-separated wallets allowed to open /admin
ADMIN_WALLETS=""
